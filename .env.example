# Copia este archivo como .env y llena los valores. El .env nunca se sube al repositorio.

# Effi ERP (Administración → Usuarios → Ver más detalles). Usuario de API dedicado, solo con permisos de consulta.
EFFI_API_KEY=
EFFI_BASE_URL=https://effi.com.co/api
EFFI_TIMEOUT=30
# 0 = solo lectura (por defecto). Solo se activa para el agente de emisión, con aprobación.
EFFI_PERMITIR_ESCRITURA=0

# DIAN (solo para --verificar-dian, con el paquete dian_consulta y el certificado .p12 de la empresa)
DIAN_AMBIENTE=produccion
DIAN_CERT_PATH=
DIAN_CERT_PASSWORD=
DIAN_NIT_EMISOR=
DIAN_NIT_PROVEEDOR=
DIAN_SOFTWARE_ID=
DIAN_TIMEOUT=30
