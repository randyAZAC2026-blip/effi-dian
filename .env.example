# Copia este archivo como .env y llena los valores. El .env nunca se sube al repositorio.

# DIAN: certificado .p12 propio de la empresa (dian_consulta y archivador). Guárdalo fuera de Drive.
DIAN_AMBIENTE=produccion
DIAN_CERT_PATH=C:/Certificados/empresa.p12
DIAN_CERT_PASSWORD=
DIAN_NIT_EMISOR=
DIAN_NIT_PROVEEDOR=
DIAN_SOFTWARE_ID=
DIAN_TIMEOUT=30
